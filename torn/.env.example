# Copie ce fichier en .env (a la racine du depot) et remplis-le.
# NE JAMAIS commiter .env — il est deja dans .gitignore.

# Cle API Torn. Une cle "Limited Access" suffit pour ce coach (lecture seule).
# Genere-la sur https://www.torn.com/preferences.php#tab=api
TORN_API_KEY=

# Optionnel — base de l'API (utile si Torn change de version)
# TORN_API_BASE=https://api.torn.com

# Optionnel — webhook Discord pour recevoir les alertes "barre pleine"
# TORN_DISCORD_WEBHOOK=

# Optionnel — port du dashboard web
# TORN_DASHBOARD_PORT=3100

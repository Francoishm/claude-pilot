# Unite systemd pour le coach Torn.
# Installee par torn/deploy/install.sh — les @PLACEHOLDERS@ y sont substitues.

[Unit]
Description=Torn Coach — dashboard et balayage du marche (lecture seule)
Documentation=file://@APP_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
ExecStart=/usr/bin/env node src/dashboard.js

Restart=on-failure
RestartSec=10s
# Le balayage du marche appelle l'API en continu : un redemarrage en boucle
# rapide gaspillerait le quota. On laisse systemd abandonner apres 5 echecs.
StartLimitBurst=5
StartLimitIntervalSec=300

# Le service ne sert qu'a lire une API et ecrire un fichier d'historique.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@APP_DIR@/data
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=torn-coach

[Install]
WantedBy=multi-user.target
